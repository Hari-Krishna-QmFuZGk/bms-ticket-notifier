# Copy to .env; source it locally. Never commit .env.
BMS_URL=https://in.bookmyshow.com/movies/hyderabad/REPLACE-MOVIE/ET00123456
BMS_CITY=hyderabad
BMS_THEATRE='REPLACE with cinema name'
BMS_DATES=20261120,20261121
BMS_TIME=13:00-23:00
BMS_SCREEN=PCX
BMS_LANGUAGE=telugu
# Also accepts exact local showtime HH:MM, e.g. 19:30. Empty = all times.
# For per-date rules, include every BMS_DATES entry, e.g.:
# BMS_TIME='{"20261120":"evening,night","20261121":""}'
CHECK_INTERVAL=10
NOTIFY_ONCE=true
STOP_AFTER_FOUND=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=
# GitHub Variable only: MONITOR_ENABLED=true explicitly activates scheduled checks.
